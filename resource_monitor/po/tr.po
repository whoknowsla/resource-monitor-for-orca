#: __init__.py:67
msgid "Resource Monitor"
msgstr "Kaynak İzleme"

#: __init__.py:69
msgid ""
"Reports processor load, memory, drives, GPU, wireless network, uptime, and "
"operating system information."
msgstr ""
"İşlemci yükü, bellek, sürücüler, GPU, kablosuz ağ, çalışma süresi ve işletim "
"sistemi bilgilerini bildirir."

#. Translators: Label for the setting that selects the GPU temperature unit.
#: __init__.py:101
msgid "GPU temperature unit"
msgstr "GPU sıcaklık birimi"

#. Translators: An option for the GPU temperature unit.
#: __init__.py:104
msgid "Celsius"
msgstr "Santigrat"

#. Translators: An option for the GPU temperature unit.
#: __init__.py:106
msgid "Fahrenheit"
msgstr "Fahrenheit"

#. Translators: Label for the setting that selects how wi-fi connects
#. and disconnects are reported.
#: __init__.py:114
msgid "Wi-fi connect/disconnect notification"
msgstr "Wi-Fi bağlanma/bağlantı kesilme bildirimi"

#. Translators: An option for the wi-fi notification setting.
#: __init__.py:117
msgid "off"
msgstr "kapalı"

#. Translators: An option for the wi-fi notification setting.
#: __init__.py:119
msgid "message"
msgstr "mesaj"

#. Translators: An option for the wi-fi notification setting.
#: __init__.py:121
msgid "sound"
msgstr "ses"

#. Translators: An option for the wi-fi notification setting.
#: __init__.py:123
msgid "both"
msgstr "her ikisi"

#. Translators: Label for the setting that leaves the command layer
#. automatically when no layer key has been pressed for a while.
#: __init__.py:131
msgid "Leave the command layer after this many idle seconds (0 = never)"
msgstr ""
"Bu kadar saniye tuşa basılmazsa komut katmanından çık (0 = hiçbir zaman)"

#. Translators: Description of the command that enters the command layer.
#: __init__.py:154
msgid "Enters the Resource Monitor command layer."
msgstr "Kaynak İzleme komut katmanına girer."

#. Translators: Description of the key that leaves the command layer.
#: __init__.py:191
msgid "Leaves the Resource Monitor command layer."
msgstr "Kaynak İzleme komut katmanından çıkar."

#. Translators: Reported when another Orca mode prevents entering the layer.
#: __init__.py:220
msgid "The command layer cannot be used while another Orca mode is active."
msgstr "Başka bir Orca modu etkinken komut katmanı kullanılamaz."

#: __init__.py:226
msgid ""
"The command layer is not available in this version of Orca. Use Orca+Shift+1 "
"through Orca+Shift+9 instead."
msgstr ""
"Komut katmanı Orca'nın bu sürümünde kullanılamıyor. Bunun yerine "
"Orca+Shift+1 ile Orca+Shift+9 arasındaki kısayolları kullanın."

#. Translators: Reported after resource information was copied to the clipboard.
#: __init__.py:275
msgid "Copied to clipboard"
msgstr "Panoya kopyalandı"

#. Translators: Reported when resource information could not be copied.
#: __init__.py:278
msgid "Could not copy to the clipboard"
msgstr "Panoya kopyalanamadı"

#. Translators: Used when a wireless network does not broadcast its name.
#. Translators: Reported for a hidden network, whose name is not broadcast.
#: __init__.py:287 reports.py:123
msgid "hidden network"
msgstr "gizli ağ"

#: __init__.py:289
#, python-brace-format
msgid "Connected to {}"
msgstr "{} ağına bağlanıldı"

#: __init__.py:291
#, python-brace-format
msgid "Disconnected from {}"
msgstr "{} ağıyla bağlantı kesildi"

#: __init__.py:293
msgid "A wireless device has been enabled"
msgstr "Bir kablosuz cihaz etkinleştirildi"

#: __init__.py:295
msgid "A wireless device has been disabled"
msgstr "Bir kablosuz cihaz devre dışı bırakıldı"

#. Translators: A size smaller than one kilobyte.
#: formatting.py:60
#, python-brace-format
msgid "{count} byte"
msgid_plural "{count} bytes"
msgstr[0] "{count} bayt"
msgstr[1] "{count} bayt"

#. Translators: system uptime in days.
#: formatting.py:72
#, python-brace-format
msgid "{days:d} day"
msgid_plural "{days:d} days"
msgstr[0] "{days:d} gün"
msgstr[1] "{days:d} gün"

#. Translators: system uptime in hours.
#: formatting.py:74
#, python-brace-format
msgid "{hours:d} hour"
msgid_plural "{hours:d} hours"
msgstr[0] "{hours:d} saat"
msgstr[1] "{hours:d} saat"

#. Translators: system uptime in minutes.
#: formatting.py:76
#, python-brace-format
msgid "{minutes:d} minute"
msgid_plural "{minutes:d} minutes"
msgstr[0] "{minutes:d} dakika"
msgstr[1] "{minutes:d} dakika"

#. Translators: system uptime in seconds.
#: formatting.py:78
#, python-brace-format
msgid "{seconds:d} second"
msgid_plural "{seconds:d} seconds"
msgstr[0] "{seconds:d} saniye"
msgstr[1] "{seconds:d} saniye"

#. Translators: Fahrenheit temperature unit appended to a GPU temperature value.
#: formatting.py:89
msgid "degrees Fahrenheit"
msgstr "derece Fahrenheit"

#. Translators: Celsius temperature unit appended to a GPU temperature value.
#: formatting.py:93
msgid "degrees Celsius"
msgstr "santigrat derece"

#. Translators: Used in place of a value the system did not report.
#: reports.py:21
msgid "unknown"
msgstr "bilinmiyor"

#. Translators: presents the overall summary of resource usage, such as CPU load and RAM usage.
#: reports.py:28
#, python-brace-format
msgid "{ramPercent}% RAM used, CPU at {cpuPercent}%."
msgstr "RAM kullanımı %{ramPercent}, CPU %{cpuPercent}."

#. Translators: Shows average load of the processor on single-core systems.
#: reports.py:40
#, python-brace-format
msgid "{avgLoad}% CPU load."
msgstr "CPU yükü %{avgLoad}."

#. Translators: Shows the load of one CPU core (example: Core 1: 50%).
#: reports.py:43
#, python-brace-format
msgid "Core {coreNumber}: {corePercent}%"
msgstr "Çekirdek {coreNumber}: %{corePercent}"

#. Translators: Shows average load of the processor and the load for each core
#. on multi-core systems.
#: reports.py:51
#, python-brace-format
msgid "{avgLoad}% average CPU load, {cores}."
msgstr "Ortalama CPU yükü %{avgLoad}, {cores}."

#. Translators: Shows RAM (physical memory) usage.
#: reports.py:58
#, python-brace-format
msgid "Physical: {physicalUsed} of {physicalTotal} used ({physicalPercent}%)."
msgstr ""
"Fiziksel: {physicalTotal} içinden {physicalUsed} kullanılıyor (%"
"{physicalPercent})."

#. Translators: Reported when the system has no swap space.
#: reports.py:65
msgid "Swap: not configured."
msgstr "Takas alanı: yapılandırılmamış."

#. Translators: Shows swap space usage.
#: reports.py:68
#, python-brace-format
msgid "Swap: {swapUsed} of {swapTotal} used ({swapPercent}%)."
msgstr ""
"Takas alanı: {swapTotal} içinden {swapUsed} kullanılıyor (%{swapPercent})."

#. Translators: word used to describe a network drive.
#: reports.py:79
msgid "network"
msgstr "ağ"

#. Translators: Reported when a drive cannot be reached, such as an offline network share.
#: reports.py:82
#, python-brace-format
msgid "{driveName} ({driveType} drive): not available."
msgstr "{driveName} ({driveType} sürücü): kullanılamıyor."

#. Translators: Shows the mount point, file system or drive type, used capacity,
#. and total capacity of a drive (example: / (btrfs drive): 40.00 GB of 100.00 GB used (40%).).
#: reports.py:88
#, python-brace-format
msgid ""
"{driveName} ({driveType} drive): {usedSpace} of {totalSpace} used ({percent}"
"%)."
msgstr ""
"{driveName} ({driveType} sürücü): {totalSpace} içinden {usedSpace} "
"kullanılıyor (%{percent})."

#. Translators: Reported when no drives could be found.
#: reports.py:102
msgid "No drives found."
msgstr "Sürücü bulunamadı."

#: reports.py:110
msgid "No wireless devices"
msgstr "Kablosuz cihaz yok"

#: reports.py:112
msgid "No wireless connections"
msgstr "Kablosuz bağlantı yok"

#: reports.py:115 resources.py:123
msgid "Unable to get wireless information"
msgstr "Kablosuz ağ bilgisi alınamıyor"

#: reports.py:117
msgid "No authentication (Open)"
msgstr "Kimlik doğrulama yok (Açık)"

#. Translators: Presents the wireless network name and security type when the
#. signal strength is not known.
#: reports.py:127
#, python-brace-format
msgid "Connected to {}, signal strength unknown, security type: {}"
msgstr "{} ağına bağlı, sinyal gücü bilinmiyor, güvenlik türü: {}"

#. Translators: Presents the wireless network name, signal strength, and security type.
#: reports.py:129
#, python-brace-format
msgid "Connected to {}, signal strength: {}%, security type: {}"
msgstr "{} ağına bağlı, sinyal gücü: %{}, güvenlik türü: {}"

#. Translators: Presents the operating system (example: Arch Linux (x86_64), kernel 6.9.1-arch1-1).
#: reports.py:138
#, python-brace-format
msgid "{distribution} ({architecture}), kernel {kernel}"
msgstr "{distribution} ({architecture}), çekirdek {kernel}"

#. Translators: Presents the desktop and display server (example: GNOME on Wayland).
#: reports.py:145
#, python-brace-format
msgid "{desktop} on {sessionType}"
msgstr "{sessionType} üzerinde {desktop}"

#: reports.py:162
msgid "No GPU information available."
msgstr "GPU bilgisi mevcut değil."

#: reports.py:165
msgid "No GPU data available."
msgstr "GPU verisi yok."

#. Translators: Shows GPU temperature when the driver does not report usage.
#: reports.py:175
#, python-brace-format
msgid "GPU {gpuNumber}: usage unknown, temp {temperature}."
msgstr "GPU {gpuNumber}: kullanım bilinmiyor, sıcaklık {temperature}."

#. Translators: Shows GPU usage and temperature (example: GPU 1: usage 25%, temp 45 degrees Celsius.).
#: reports.py:180
#, python-brace-format
msgid "GPU {gpuNumber}: usage {usage}%, temp {temperature}."
msgstr "GPU {gpuNumber}: kullanım %{usage}, sıcaklık {temperature}."

#: reports.py:191
msgid "Unable to get GPU information."
msgstr "GPU bilgisi alınamıyor."

#. Translators: Shows GPU memory usage (example: 2.00 GB of 8.00 GB used (25%)).
#: reports.py:205
#, python-brace-format
msgid "{used} of {total} used ({percent}%)"
msgstr "{total} içinden {used} kullanılıyor (%{percent})"

#. Translators: Shows GPU memory usage (example: GPU 1: 2.00 GB of 8.00 GB used (25%).).
#: reports.py:211
#, python-brace-format
msgid "GPU {gpuNumber}: {memoryInfo}."
msgstr "GPU {gpuNumber}: {memoryInfo}."

#: reports.py:215 reports.py:216
msgid "Unable to get GPU memory information."
msgstr "GPU bellek bilgisi alınamıyor."

#. Translators: Appended to every resource command description.
#: resources.py:59
msgid "If pressed twice, copies the information to the clipboard."
msgstr "İki kez basılırsa bilgiyi panoya kopyalar."

#. Translators: Description of the overall resource usage command.
#: resources.py:66
msgid "Presents used RAM and average processor load."
msgstr "Kullanılan RAM'i ve ortalama işlemci yükünü bildirir."

#. Translators: Reported when the overall resource usage command fails.
#: resources.py:69
msgid "Failed to get resource usage information."
msgstr "Kaynak kullanım bilgisi alınamadı."

#: resources.py:78
msgid "Presents the average processor load and the load of each core."
msgstr "Ortalama işlemci yükünü ve her çekirdeğin yükünü bildirir."

#. Translators: Reported when the processor command fails.
#: resources.py:82
msgid "Failed to get processor information."
msgstr "İşlemci bilgisi alınamadı."

#: resources.py:91
msgid "Presents the used and total space for both physical memory and swap."
msgstr ""
"Fiziksel bellek ve takas alanının kullanılan ve toplam boyutunu bildirir."

#. Translators: Reported when the memory command fails.
#: resources.py:95
msgid "Failed to get memory information."
msgstr "Bellek bilgisi alınamadı."

#: resources.py:104
msgid "Presents the used and total space of the local and network drives."
msgstr "Yerel ve ağ sürücülerinin kullanılan ve toplam alanını bildirir."

#. Translators: Reported when the drives command fails.
#: resources.py:108
msgid "Failed to get drive information."
msgstr "Sürücü bilgisi alınamadı."

#: resources.py:118
msgid ""
"Announces the wireless network name (SSID), signal strength, and security "
"type."
msgstr "Kablosuz ağ adını (SSID), sinyal gücünü ve güvenlik türünü bildirir."

#: resources.py:132
msgid ""
"Announces the Linux distribution, processor architecture, kernel, and "
"desktop."
msgstr ""
"Linux dağıtımını, işlemci mimarisini, çekirdeği ve masaüstünü bildirir."

#. Translators: Reported when the operating system command fails.
#: resources.py:136
msgid "Failed to get operating system information."
msgstr "İşletim sistemi bilgisi alınamadı."

#. Translators: Description of the uptime command.
#: resources.py:144
msgid "Announces the system's uptime."
msgstr "Sistemin çalışma süresini bildirir."

#. Translators: Obtaining uptime failed.
#: resources.py:147
msgid "Failed to get the system's uptime."
msgstr "Sistemin çalışma süresi alınamadı."

#. Translators: Description of the GPU usage and temperature command.
#: resources.py:155
msgid "Announces GPU usage and temperature."
msgstr "GPU kullanımını ve sıcaklığını bildirir."

#. Translators: Message reported when the GPU command fails unexpectedly.
#: resources.py:158
msgid "Failed to get GPU information."
msgstr "GPU bilgisi alınamadı."

#. Translators: Description of the GPU memory command.
#: resources.py:166
msgid "Announces GPU memory usage."
msgstr "GPU bellek kullanımını bildirir."

#. Translators: Message reported when the GPU memory command fails unexpectedly.
#: resources.py:169
msgid "Failed to get GPU memory information."
msgstr "GPU bellek bilgisi alınamadı."
